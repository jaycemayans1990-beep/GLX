-- ==========================================
-- 4. WEAPON SERVICE (Cached Weapon Stats)
-- ==========================================
WeaponService = {
        Speed = FALLBACK_SPEED,
        Gravity = workspace.Gravity
}

function WeaponService:UpdateManual()
        if not State.AutoBulletSpeed then
                self.Speed = math.max(State.BulletSpeed or FALLBACK_SPEED, 1)
                self.Gravity = State.BulletGravity or workspace.Gravity
        end
end

local WeaponCache = setmetatable({}, { __mode = "k" })

function WeaponService:InvalidateCache()
        table.clear(WeaponCache)
end

function WeaponService:UpdateAuto()
        if not State.AutoBulletSpeed then return self:UpdateManual() end

        local char = LocalPlayer and LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")

        if not tool then
                self.Speed = FALLBACK_SPEED
                self.Gravity = workspace.Gravity
                return
        end

        local cached = WeaponCache[tool]
        if cached then
                self.Speed = cached.Speed
                self.Gravity = cached.Gravity
                return
        end

        local toolName = tool.Name:lower()
        local isLauncher = toolName:find("rpg") or toolName:find("rocket")
                or toolName:find("launcher") or toolName:find("grenade")
        local acsSettings = tool:FindFirstChild("ACS_Settings")
                or tool:FindFirstChild("Settings") or tool:FindFirstChild("Config")

        local speed, gravity = FALLBACK_SPEED, workspace.Gravity

        if acsSettings and acsSettings:IsA("ModuleScript") then
                local success, config = pcall(require, acsSettings)
                if success and type(config) == "table" then
                        local s = config.Velo or config.MuzzleVelocity or config.BulletSpeed or config.Velocity
                        speed = (type(s) == "number" and s > 0) and s or speed

                        local drop = config.Drop or config.BulletDrop or config.Gravity
                        if type(drop) == "number" then
                                gravity = State.DropIsMultiplier and (workspace.Gravity * drop) or drop
                        else
                                gravity = (isLauncher and not toolName:find("grenade")) and 0 or workspace.Gravity
                        end
                end
        end

        WeaponCache[tool] = { Speed = speed, Gravity = gravity }
        self.Speed = speed
        self.Gravity = gravity
end

local HookedTools = setmetatable({}, { __mode = "k" })
local CONFIG_HINTS = { "acs_settings", "settings", "config" }

local function hookToolConfigWatcher(tool)
        if HookedTools[tool] then return end
        HookedTools[tool] = true
        tool.ChildAdded:Connect(function(child)
                local childName = child.Name:lower()
                for _, hint in ipairs(CONFIG_HINTS) do
                        if childName:find(hint) then
                                WeaponCache[tool] = nil
                                local char = LocalPlayer and LocalPlayer.Character
                                if char and char:FindFirstChildOfClass("Tool") == tool then
                                        WeaponService:UpdateAuto()
                                end
                                break
                        end
                end
        end)
end

local function setupCharacterWeaponListener(char)
        if not char then return end
        CleanupManager:AddConn("ToolAdded", char.ChildAdded:Connect(function(child)
                if child:IsA("Tool") then
                        hookToolConfigWatcher(child)
                        task.defer(function()
                                local t = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                                if t == child then WeaponService:UpdateAuto() end
                        end)
                end
        end))
        CleanupManager:AddConn("ToolRemoved", char.ChildRemoved:Connect(function()
                task.defer(function() WeaponService:UpdateAuto() end)
        end))
        WeaponService:UpdateAuto()
end

if LocalPlayer then
        if LocalPlayer.Character then setupCharacterWeaponListener(LocalPlayer.Character) end
        CleanupManager:AddConn("CharAdded", LocalPlayer.CharacterAdded:Connect(setupCharacterWeaponListener))
end


local TargetStates = setmetatable({}, { __mode = "k" })
local MAX_SAMPLE_DT = 0.1
local MAX_PREDICTION_TIME = 5.0
local MAX_DV_PER_SAMPLE = 35
local SPIKE_COOLDOWN = 0.15
local MAX_ACCEL = 200
local ACCEL_TAU_BASE = 0.10
local MAX_ACCEL_LEAD = 12
local VEL_TAU = 0.05
local VELOCITY_SANITY = 3000

local function clampAccelLead(v3, cap)
        local m = v3.Magnitude
        if m > cap then return v3 * (cap / m) end
        return v3
end


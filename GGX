local function hasActiveWeapon()
        local character = LocalPlayer and LocalPlayer.Character
        if not character then return false end
        if State.WeaponCheck == false then return true end
        return character:FindFirstChildOfClass("Tool") ~= nil
end

print("[GLX v3.10] โหลดสำเร็จ — aimbot + ESP + self-heal watchdog (ไม่มี hook / ไม่มี input สังเคราะห์)")

local flickUntil = 0
local flickArmStart = nil
local FLICK_ARM = 0.06
local prevReadLook = nil
local lastWriteLook = nil
local FLICK_HOLD = 0.10
local STEER_DPS = 30
local STEER_HOLD = 0.22
local STEER_MIN_INFLUENCE = 0.15
local STEER_TAU = 0.07

local steerInfluence = 1
local steerHoldStart = nil
local prevErrDeg = nil

local lastRenderTick = os.clock()
local renderErrStreak = 0
local function renderTick(deltaTime)
        local camera = getCamera()
        if not camera then return end

        local userLook = camera.CFrame.LookVector
        local dtSafe = math.max(deltaTime, 1e-4)
        local userDps = math.huge
        if prevReadLook then
                local uDot = math.clamp(userLook:Dot(prevReadLook), -1, 1)
                local uDeg = math.deg(math.acos(uDot))
                if uDeg > 0.05 then userDps = uDeg / dtSafe end
        end
        if lastWriteLook then
                local wDot = math.clamp(userLook:Dot(lastWriteLook), -1, 1)
                local wDeg = math.deg(math.acos(wDot))
                local againstPull = false
                if prevReadLook then
                        local pullAxis = prevReadLook:Cross(lastWriteLook)
                        local handAxis = lastWriteLook:Cross(userLook)
                        againstPull = pullAxis:Dot(handAxis) < 0
                end
                if againstPull or wDeg / dtSafe < userDps then
                        userDps = wDeg / dtSafe
                end
        end
        if userDps == math.huge then userDps = 0 end
        prevReadLook = userLook
        lastWriteLook = nil
        local nowClock = os.clock()

        if State.DragSwitch and userDps > (State.FlickSpeed or 90) then
                if not flickArmStart then flickArmStart = nowClock end
                if nowClock - flickArmStart >= FLICK_ARM then
                        flickUntil = nowClock + FLICK_HOLD
                end
        else
                flickArmStart = nil
        end

        local zoomRaw = getZoomScale(camera)
        if not zoomSmoothed then
                zoomSmoothed = zoomRaw
        else
                zoomSmoothed += (zoomRaw - zoomSmoothed) * (1 - math.exp(-deltaTime / ZOOM_TAU))
        end

        local vp = camera.ViewportSize
        local screenCX, screenCY = vp.X * 0.5, vp.Y * 0.5
        local scaledFOV = State.FOV * (vp.Y / 1080) / math.max(zoomSmoothed or 1, 1)

        if State.ShowFOV then
                if FOVCircle.Position.X ~= screenCX or FOVCircle.Position.Y ~= screenCY then
                        FOVCircle.Position = Vector2.new(screenCX, screenCY)
                end
                if FOVCircle.Radius ~= scaledFOV then
                        FOVCircle.Radius = scaledFOV
                end
                if not FOVCircle.Visible then
                        FOVCircle.Visible = true
                end
        elseif FOVCircle.Visible then
                FOVCircle.Visible = false
        end

        if not State.Aimbot or not hasActiveWeapon() then
                if TargetService.CurrentTarget then TargetService:ReleaseTarget() end
                prevErrDeg = nil
                steerInfluence = 1
                steerHoldStart = nil
                return
        end

        if State.DragSwitch and nowClock < flickUntil then
                if TargetService.CurrentTarget then
                        switchAwayKey = TargetService.CurrentTarget
                        switchCooldownUntil = nowClock + SWITCH_COOLDOWN
                        TargetService:ReleaseTarget()
                end
                steerInfluence = 1
                steerHoldStart = nil
                prevErrDeg = nil
                return
        end

        if switchAwayKey and nowClock >= switchCooldownUntil then
                switchAwayKey = nil
        end

        if TargetService.CurrentTarget then
                if not isValidEnemy(TargetService.CurrentTarget) then
                        TargetService:ReleaseTarget()
                else
                        local keep, offScreen = TargetService:KeepTarget(camera, screenCX, screenCY, scaledFOV)
                        if keep then
                                targetGraceUntil = 0
                        else
                                if targetGraceUntil == 0 and not offScreen then
                                        targetGraceUntil = nowClock + TARGET_GRACE
                                end
                                if offScreen or nowClock >= targetGraceUntil then
                                        TargetService:ReleaseTarget()
                                end
                        end
                end
        end

        if not TargetService.CurrentTarget then
                TargetService:AcquireTarget(camera, screenCX, screenCY, scaledFOV)
        end

        if State.SwitchAssist and TargetService.CurrentTarget then
                TargetService:CheckSwitch(camera, screenCX, screenCY, scaledFOV)
        end

        local targetPart = TargetService.TargetPart
        if TargetService.CurrentTarget and targetPart and targetPart.Parent then
                local shooterPos = camera.CFrame.Position
                local zoomScale = zoomSmoothed
                local baseRate = (10 + State.Smoothness * 30) * zoomScale
                local leadTau = State.LagComp and math.min(1 / baseRate, 0.15) or 0
                local targetPos = getPredictedPosition(targetPart, shooterPos, deltaTime, leadTau, zoomScale)

                local desiredDirection = safeUnit(targetPos - shooterPos)
                if desiredDirection then
                        local dot = math.clamp(camera.CFrame.LookVector:Dot(desiredDirection), -1, 1)
                        local errDeg = math.deg(math.acos(dot))
                        local errScaled = errDeg * zoomScale
                        local gain = State.TrackBoost or 1.5
                        local effSpeed = math.min(baseRate + errScaled * gain, 70)
                        local sdt = math.min(deltaTime, 1 / 30)
                        local alpha = 1 - math.exp(-effSpeed * sdt)
                        local maxStepDps = (120 + State.Smoothness * 240) * zoomScale
                        alpha = math.min(alpha, (maxStepDps * sdt) / math.max(errDeg, 0.05))

                        local steering = State.FreeSteer and userDps > STEER_DPS
                                and prevErrDeg ~= nil and errDeg > prevErrDeg + 0.05
                        if steering then
                                if not steerHoldStart then steerHoldStart = nowClock end
                                if State.DragSwitch and nowClock - steerHoldStart >= STEER_HOLD then
                                        switchAwayKey = TargetService.CurrentTarget
                                        switchCooldownUntil = nowClock + SWITCH_COOLDOWN
                                        TargetService:ReleaseTarget()
                                        flickUntil = nowClock + FLICK_HOLD
                                        return
                                end
                        else
                                steerHoldStart = nil
                        end
                        local infTarget = steering and STEER_MIN_INFLUENCE or 1
                        steerInfluence += (infTarget - steerInfluence) * (1 - math.exp(-deltaTime / STEER_TAU))

                        alpha = math.clamp(alpha, 0, 1)
                        steerInfluence = math.clamp(steerInfluence, 0, 1)
                        local smoothDirection = safeUnit(camera.CFrame.LookVector:Lerp(desiredDirection, alpha * steerInfluence))
                        if smoothDirection then
                                local ok, newCFrame = pcall(CFrame.lookAt, shooterPos, shooterPos + smoothDirection)
                                if ok and newCFrame then
                                        camera.CFrame = newCFrame
                                        lastWriteLook = smoothDirection
                                end
                        end
                        prevErrDeg = errDeg
                end
        end
end

local function connectRenderLoop()
        CleanupManager:AddConn("RenderStep", RunService.RenderStepped:Connect(function(deltaTime)
                lastRenderTick = os.clock()
                local ok, err = xpcall(renderTick, traceFn, deltaTime)
                if ok then
                        renderErrStreak = 0
                else
                        renderErrStreak += 1
                        if renderErrStreak == 10 then
                                warn("[GLX v3.10] aim loop error: " .. tostring(err))
                                if setStickyStatus then
                                        setStickyStatus("aim error: " .. tostring(err):sub(1, 40))
                                end
                        end
                end
        end))
end
connectRenderLoop()

setGlxStatus("โหลดครบทุกระบบ — พร้อมใช้")

local stickyMsg, stickyUntil = nil, 0
setStickyStatus = function(msg)
        stickyMsg = tostring(msg)
        stickyUntil = os.clock() + 6
        warn("[GLX v3.10] " .. stickyMsg)
        if StatusLabel then StatusLabel.Text = stickyMsg end
end

do
        local watchdogAccum = 0
        CleanupManager:AddConn("Watchdog", RunService.Heartbeat:Connect(function(dt)
                watchdogAccum += dt
                if watchdogAccum < 1 then return end
                watchdogAccum = 0
                local now = os.clock()
                if State.Aimbot and now - lastRenderTick > 2 then
                        local oldConn = CleanupManager.Connections.RenderStep
                        if not (oldConn and oldConn.Connected) then
                                lastRenderTick = now
                                connectRenderLoop()
                                setStickyStatus("watchdog: ฟื้น aim loop กลับมาแล้ว")
                        else
                                lastRenderTick = now
                        end
                end
                if (State.ESP or State.ESPName) and now - lastEspTick > 2 then
                        local oldEspConn = CleanupManager.Connections.ESP_Heartbeat
                        if not (oldEspConn and oldEspConn.Connected) then
                                lastEspTick = now
                                connectESP()
                                setStickyStatus("watchdog: ฟื้น ESP loop กลับมาแล้ว")
                        else
                                lastEspTick = now
                        end
                end
        end))
end

do
        local fpsFrames, fpsAccum = 0, 0
        CleanupManager:AddConn("FPSMeter", RunService.Heartbeat:Connect(function(dt)
                fpsFrames += 1
                fpsAccum += dt
                if fpsAccum >= 1 then
                        local fps = math.floor(fpsFrames / fpsAccum + 0.5)
                        fpsFrames, fpsAccum = 0, 0
                        if StatusLabel then
                                local text
                                if stickyMsg and os.clock() < stickyUntil then
                                        text = stickyMsg
                                else
                                        text = "FPS " .. fps
                                end
                                if text ~= lastStatusText or statusDirty then
                                        lastStatusText = text
                                        statusDirty = false
                                        if MainFrame.Visible then
                                                StatusLabel.Text = text
                                        end
                                end
                        end
                end
        end))
end
